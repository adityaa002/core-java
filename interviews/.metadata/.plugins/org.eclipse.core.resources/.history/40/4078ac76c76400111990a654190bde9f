package com.javabasics;

public class PrimeNumber {
	public static void main(String[] args) {
		
		int num = 153;
		
		boolean isPrime = true;
		
		for(int i = 2 ; i < num ; i++) {
			
			if(num%i==0) {
				isPrime = false;
				break;
			}
		}
		if(isPrime) {
			System.out.println(num + " is prime...!");
		}else {
			System.out.println(num + " isn't prime...!");

		}
		
		
	}
}
